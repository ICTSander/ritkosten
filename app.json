{
  "expo": {
    "name": "Ritkosten",
    "slug": "ritkosten",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ritkosten",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "nl.ritkosten.app",
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ritkosten gebruikt je locatie alleen om je auto- en OV-route vanaf waar je nu bent te berekenen. Je locatie wordt niet bewaard.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A5BB0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "package": "nl.ritkosten.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ritkosten gebruikt je locatie alleen om de route vanaf waar je nu bent te berekenen. Je locatie wordt niet bewaard."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A5BB0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A5BB0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Vergelijk voor elke reis wat het kost met de auto en met het OV, en reis stap voor stap met live treininfo."
  }
}
