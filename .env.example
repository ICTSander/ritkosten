# Everything works WITHOUT any key: RDW, CBS, PDOK, Photon, FOSSGIS routing and Transitous are keyless.
# All variables below are OPTIONAL.
#
# NOTE: variables prefixed EXPO_PUBLIC_ are inlined into the app bundle and are therefore PUBLIC.
# Never put a secret (NS key, 9292 token) in an EXPO_PUBLIC_ variable — use the proxy in /proxy.

# Contact info sent in the User-Agent to Transitous (their policy asks clients to identify themselves),
# e.g. "https://example.com/contact" or an e-mail address you want them to reach you on.
EXPO_PUBLIC_APP_CONTACT=

# Socrata app token for opendata.rdw.nl — not a secret; only raises RDW rate limits.
EXPO_PUBLIC_RDW_APP_TOKEN=

# Base URL of YOUR proxy (see proxy/ns-worker.js). When set, the app uses NS Reisinformatie
# (realtime + official NS fares) via this proxy. The NS key itself lives on the proxy as NS_API_KEY.
EXPO_PUBLIC_API_BASE_URL=

# OpenRouteService key (free tier), last routing fallback only. Prefer moving it behind the proxy.
EXPO_PUBLIC_ORS_API_KEY=

# DEVELOPMENT ONLY: "1" adds a clearly-labelled fake journey planner (works only in __DEV__ builds).
EXPO_PUBLIC_TRANSIT_MOCK=

# --- Server-side only (proxy), never in the app ---
# NS_API_KEY=            # https://apiportal.ns.nl (free registration)
# TODO(licence): 9292 Reisadvies API token — requires a contract with 9292 (https://9292.nl/zakelijk/9292-reisadvies-api)
