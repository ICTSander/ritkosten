        "EXPO_PUBLIC_API_BASE_URL": "https://ritkosten-proxy.ritkosten.workers.dev",
        "EXPO_PUBLIC_APP_CONTACT": "https://github.com/ICTSander/ritkosten"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
